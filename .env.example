# Optional public site URL (used for Open Graph / metadata)
NEXT_PUBLIC_SITE_URL=https://slice.vercel.app

# Persist claims across serverless instances (pick one pair).
# Vercel KV / Upstash Redis REST — same protocol.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Or the Upstash-native names:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional extra salt for email uniqueness hashes (defaults to a built-in).
# CLAIM_HASH_SALT=

# Demo-only: starting claimant count when no KV is configured (default 0).
# SLICE_DEMO_SEED_COUNT=0
